# byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# virtual environments
venv/
.venv/
env/
.env/

# environment variables
.env
.env.*

# jupyter notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# prevents uploading massive model files to github
*.pt
*.pth
*.onnx
*.safetensors
*.h5
*.pkl

# huggingface and local caching directories
.cache/
wandb/

# ignore large datasets and document files
*.csv
*.tsv
*.parquet
*.jsonl

# local vector database storage (e.g., chromadb, faiss)
chroma_db/
faiss_index/
vector_store/

# directories for raw and processed documents used for embeddings
data/raw/
data/processed/

# os & editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
